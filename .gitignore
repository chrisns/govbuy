# secrets / env — NEVER commit the real .env (holds the Companies House + Anthropic keys)
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# node / build
node_modules/
dist/
build/

# og-card brand-font cache (downloaded at build time; the generated public/og.png IS committed)
api/scripts/.ogfonts/

# terraform
.terraform/
*.tfstate
*.tfstate.*

# os / editor
.DS_Store
*.swp
.idea/
.vscode/

# browser-tool scratch
.playwright-mcp/

# claude local state (scheduler lock etc.)
.claude/

# local scratch — intermediate scrape dumps (non-CCS working files), not source
/cpc_*.json
/cpc_*.html
/lupc_*.json
