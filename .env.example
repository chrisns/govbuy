# Copy to .env and fill in. The real .env is gitignored.

# Companies House Public Data API key — https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API=

# Anthropic API key for LOCAL runs of the ingestion harness (tiered: Haiku 5.5 extract / Sonnet 5.5 verify /
# Opus 5.5 discover). Use a key from the govbuy workspace so its rate + spend limits apply. CI uses no key:
# it authenticates with Workload Identity Federation (docs/adr/0007).
ANTHROPIC_API_KEY=

# GCP project the API + datasets deploy into (shared with find-tender-mcp)
GCP_PROJECT=govreposcrape
