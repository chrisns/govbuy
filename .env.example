# Copy to .env and fill in. The real .env is gitignored.

# Companies House Public Data API key — https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API=

# Anthropic API key for the ingestion harness (tiered: Haiku extract / Sonnet verify / Opus discover)
ANTHROPIC_API_KEY=

# GCP project the API + datasets deploy into (shared with find-tender-mcp)
GCP_PROJECT=govreposcrape
